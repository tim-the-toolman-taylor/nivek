APP_NAME=nivek
CORE_API_PORT=8080
CORE_API_LISTEN_ADDRESS=0.0.0.0

POSTGRES_USERNAME=nivek
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=nivek
POSTGRES_HOST=postgres
POSTGRES_SSL_MODE=disable

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes

TWITCH_CLIENT_ID=replace-me
TWITCH_CLIENT_SECRET=replace-me
# Must exactly match the callback registered in the Twitch developer console.
TWITCH_REDIRECT_URI=https://peanutbudderbot.com/api/auth/twitch/callback
FRONTEND_BASE_URL=https://peanutbudderbot.com

# EventSub is independent from login. Leave callback blank to skip automatic
# subscriptions while preserving OAuth sign-in.
TWITCH_EVENTSUB_SECRET=replace-with-a-long-random-secret
TWITCH_EVENTSUB_CALLBACK_URL=https://peanutbudderbot.com/api/eventsub

# Overlay relay. A SEPARATE secret and callback from the bot's above: the two
# subscription sets are created, revoked, and rotated independently, so a
# rotation here cannot break chat. Leave the secret blank to disable the relay's
# webhook (it answers 503) without affecting anything else.
# Generate with: openssl rand -base64 48
OVERLAY_EVENTSUB_SECRET=
OVERLAY_EVENTSUB_CALLBACK_URL=https://peanutbudderbot.com/api/overlay/eventsub

SESSION_COOKIE_SECURE=true
# Usually blank. Set only when intentionally sharing across subdomains.
SESSION_COOKIE_DOMAIN=
SESSION_TTL_MINUTES=480

BOT_INTERNAL_URL=http://172.19.0.1:8090
BOT_API_HMAC_KEY=replace-with-a-64-character-hex-key
DASHBOARD_PUSH_HMAC_KEY=replace-with-a-64-character-hex-key

WINDY_API_TOKEN=
IP_INFO_API_TOKEN=
TWITCH_API_TOKEN=
